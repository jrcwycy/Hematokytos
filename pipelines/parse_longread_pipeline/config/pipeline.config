# ============================================================================
# pipeline.config  --  single source of truth for the Parse long-read
#                      split-pipe SLURM pipeline. Sourced by every script in
#                      bin/ and slurm/. Every value can be overridden from the
#                      environment, e.g.:
#
#                          SLURM_ACCOUNT=myaccount KIT=WT bin/lr_submit.sh
#
# Edit the values marked >>> EDIT <<< to match your environment, then run
# bin/lr_submit.sh from an HPC login node with `sbatch` available.
# ============================================================================
# shellcheck shell=bash

# ---------------------------------------------------------------------------
# 1. Scheduler / account
# ---------------------------------------------------------------------------
# >>> EDIT <<<  Your Slurm allocation and notification address.
SLURM_ACCOUNT="${SLURM_ACCOUNT:-myaccount}"
SLURM_PARTITION="${SLURM_PARTITION:-standard}"          # standard | largemem | gpu
SLURM_MAIL_USER="${SLURM_MAIL_USER:-you@example.edu}"
SLURM_MAIL_TYPE="${SLURM_MAIL_TYPE:-END,FAIL}"

# ---------------------------------------------------------------------------
# 2. Software environment
#    How `split-pipe` becomes available on a compute node. split-pipe itself
#    is Parse Biosciences licensed software (not part of this repo) and must
#    be installed into this conda env yourself -- see bin/lr_install_env.sh.
# ---------------------------------------------------------------------------
# >>> EDIT <<<  Where your conda/mamba lives and the env that has split-pipe.
CONDA_BASE="${CONDA_BASE:-$HOME/miniconda3}"
CONDA_ENV="${CONDA_ENV:-spipe}"
# Optional Lmod modules to load before activating conda (space separated, or "").
LOAD_MODULES="${LOAD_MODULES:-}"

# ---------------------------------------------------------------------------
# 3. Input data
# ---------------------------------------------------------------------------
# >>> EDIT <<<  Directory containing the raw long-read fastq chunks.
FASTQ_DIR="${FASTQ_DIR:-/path/to/long_read_fastqs/}"

# Reference inputs for `split-pipe --mode mkref` (e.g. a 10x Genomics
# refdata-gex bundle, which ships an unpacked FASTA + GTF that mkref consumes
# directly).
# >>> EDIT <<<
GENOME_NAME="${GENOME_NAME:-hg38}"
GTF_PATH="${GTF_PATH:-/path/to/reference/genes.gtf}"
FASTA_PATH="${FASTA_PATH:-/path/to/reference/genome.fa}"

# If you already built a Parse reference (this dir contains a genome built by
# `split-pipe --mode mkref`), set this to skip the refs stage's STAR build.
# Leave empty to build it fresh (section 8 below points this at shared scratch
# by default so it's built once and reused across runs).
PARSE_GENOME_DIR="${PARSE_GENOME_DIR:-}"

# ---------------------------------------------------------------------------
# 4. Parse kit / chemistry  (run `split-pipe --kit_list` to see valid values)
#    VERIFY these against how the library was actually prepped & sequenced --
#    see slurm/lr/05_guesskit.sbatch to determine the kit empirically instead
#    of assuming it from a label.
# ---------------------------------------------------------------------------
KIT="${KIT:-WT}"                # WT | WT_mini | WT_mega | WT_mega_384 | WT_penta | WT_penta_384
CHEMISTRY="${CHEMISTRY:-v3}"    # v1 | v2 | v3 | v4 ...

# Sample <-> well assignment. Leave empty to let split-pipe process every well
# (one "all-sample" output). To label samples, point this at your real
# SampleLoadingTable .xlsm -- see samples/README.md.
SAMPLE_TABLE="${SAMPLE_TABLE:-}"

# ---------------------------------------------------------------------------
# 5. Scratch + results  (the executor writes everything heavy to scratch)
# ---------------------------------------------------------------------------
# >>> EDIT <<<  Your cluster's fast per-user scratch and a shared/group folder.
SCRATCH_BASE="${SCRATCH_BASE:-/scratch/$USER}"
SHARED_BASE="${SHARED_BASE:-/scratch/shared_data/parse}"

# A run id ties refs + every array task + finalize to one working tree.
# bin/lr_submit.sh stamps this with a timestamp by default.
RUN_ID="${RUN_ID:-parse_lr_run}"

# All intermediate + heavy I/O lives here, on per-user fast scratch.
WORK_DIR="${WORK_DIR:-$SCRATCH_BASE/parse_lr_demux/$RUN_ID}"

# Final results are staged to the shared scratch folder.
RESULTS_DIR="${RESULTS_DIR:-$SHARED_BASE/analysis/$RUN_ID}"

# ===========================================================================
# 6. Long-read (Nanopore / PacBio) workflow
#    LR_generate_pairs (edlib linker split) -> concat -> split-pipe --mode pre
#    -> minimap2 (spliced) -> patch stats + sam->bam -> split-pipe --mode post
# ===========================================================================
# All fastq chunks under FASTQ_DIR belong to ONE Parse sublibrary.
# >>> EDIT <<<
LR_SUBLIB="${LR_SUBLIB:-my_sublibrary}"

# LR_generate_pairs script + edit distances. This script ships with Parse's
# long-read documentation / your licensed split-pipe install -- point this at
# your own copy (e.g. <your split-pipe dir>/LR_generate_pairs_1.0.0.py).
: "${LR_PAIRS_SCRIPT:?set LR_PAIRS_SCRIPT to the path of LR_generate_pairs_*.py from your licensed Parse split-pipe install}"
LR_L1DIST="${LR_L1DIST:-1}"          # max edit distance, linker 1 (<=3 advised)
LR_L2DIST="${LR_L2DIST:-1}"          # max edit distance, linker 2

# minimap2 long-read preset: ONT -> 'splice' (-x), PacBio HiFi -> 'splice:hq'.
MM2_XPRESET="${MM2_XPRESET:-splice}"             # alignment preset for barcode_head reads
MM2_INDEX_PRESET="${MM2_INDEX_PRESET:-map-ont}"  # index build preset (-x for -d)

# Reference outputs (built once into the shared scratch folder, then reused).
# Overrides section 3's empty PARSE_GENOME_DIR default so refs are reused.
PARSE_GENOME_DIR="${PARSE_GENOME_DIR:-$SHARED_BASE/refs/$GENOME_NAME/star}"
MM2_INDEX="${MM2_INDEX:-$SHARED_BASE/refs/$GENOME_NAME/minimap2/${GENOME_NAME}.${MM2_INDEX_PRESET}.mmi}"
JUNC_BED="${JUNC_BED:-$SHARED_BASE/refs/$GENOME_NAME/minimap2/${GENOME_NAME}.genes.bed}"

# split-pipe long-read parfile values (verify these keys against your
# split-pipe version -- see docs/longread-pipeline.md for known changes
# between versions).
#   pre_check_name_match False : R1/R2 names won't match after the LR split
#   mol_min_mapq_score   60    : minimap2 unique-map MAPQ (STAR uses 255)
#   pre_keep_no_bc_fq    True  : keep reads with no barcode (per Parse LR doc)
#   pre_min_R1_len       10    : LR transcript reads can be short
LR_PARFILE_LINES="${LR_PARFILE_LINES:-pre_check_name_match False
mol_min_mapq_score 60
pre_keep_no_bc_fq True
pre_min_R1_len 10}"

# Per-chunk generate-pairs array throttle (max concurrent array tasks).
LR_ARRAY_THROTTLE="${LR_ARRAY_THROTTLE:-100}"

# Resources: genpairs (per chunk, single-threaded edlib) / finalize (pre+align+post) / refs.
GENPAIRS_CPUS="${GENPAIRS_CPUS:-2}";  GENPAIRS_MEM="${GENPAIRS_MEM:-8G}";   GENPAIRS_TIME="${GENPAIRS_TIME:-02:00:00}"
FINAL_CPUS="${FINAL_CPUS:-16}";       FINAL_MEM="${FINAL_MEM:-64G}";        FINAL_TIME="${FINAL_TIME:-24:00:00}"
REFS_CPUS="${REFS_CPUS:-16}";         REFS_MEM="${REFS_MEM:-64G}";          REFS_TIME="${REFS_TIME:-08:00:00}"
